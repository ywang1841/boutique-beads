@page "{id:int}"
@model BoutiqueBeads.Areas.Admin.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>

<form method="post" enctype="multipart/form-data" style="max-width:560px;">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <label>Name</label>
    <input asp-for="Input.Name" class="form-control" />

    <label>Description</label>
    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>

    <label>Price (USD)</label>
    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" />

    <label>Quick Order URL</label>
    <input asp-for="Input.QuickOrderUrl" class="form-control" />

    <label><input asp-for="Input.IsFeatured" type="checkbox" /> Feature on homepage</label>
    <label><input asp-for="Input.IsActive" type="checkbox" /> Active / visible on site</label>

    <hr />
    <h3>Current Photos</h3>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        @foreach (var img in Model.CurrentImages)
        {
            <div>
                <img src="@img.BlobUrl" style="width:100px;height:100px;object-fit:cover;border-radius:4px;" />
                <button type="submit" asp-page-handler="DeleteImage" asp-route-imageId="@img.Id" class="btn btn-outline" style="display:block;margin-top:4px;">Remove</button>
            </div>
        }
    </div>

    <label style="margin-top:16px;display:block;">Add More Photos</label>
    <input asp-for="Input.NewImageFiles" type="file" class="form-control" multiple accept="image/*" />

    <button type="submit" class="btn btn-primary" style="margin-top:16px;">Save Changes</button>
</form>
